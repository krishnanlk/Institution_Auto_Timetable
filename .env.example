# .env.example — Copy this to .env and fill in your values
# Leave DATABASE_URL blank to use local SQLite (default for development)

# ── Supabase / PostgreSQL (Production) ────────────────────────────────────────
# Get this from: Supabase Dashboard → Settings → Database → Connection String → URI
# Use the "Connection Pooler" URL (port 6543) for serverless/Flask deployments
#
# DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── How to set up Supabase ─────────────────────────────────────────────────────
# 1. Go to https://supabase.com → New project
# 2. In the SQL Editor, run the contents of supabase_setup.sql
# 3. Copy your connection string from Settings → Database → Connection String
# 4. Paste it as DATABASE_URL above
# 5. Restart the app → all data will now go to Supabase PostgreSQL
